{
    "containerDefinitions": [
        {
            "name": "repio-intelligence-prod-container",
            "image": "590184142947.dkr.ecr.eu-west-3.amazonaws.com/prod/repio-intelligence",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "port-temporal-grpc",
                    "containerPort": 7233,
                    "hostPort": 7233,
                    "protocol": "tcp",
                    "appProtocol": "grpc"
                }
            ],
            "essential": true,
            "environment": [],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/repio-intelligence-prod-task-definition",
                    "mode": "non-blocking",
                    "awslogs-create-group": "true",
                    "max-buffer-size": "25m",
                    "awslogs-region": "eu-west-3",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "family": "repio-intelligence-prod-task-definition",
    "taskRoleArn": "arn:aws:iam::590184142947:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::590184142947:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "3072",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "tags": []
}